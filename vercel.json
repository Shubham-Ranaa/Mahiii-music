{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/MAHII.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=\"MAHII.apk\""
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/MAHII-1.4.6-release.apk",
      "destination": "/MAHII.apk",
      "permanent": false
    },
    {
      "source": "/download.apk",
      "destination": "/MAHII.apk",
      "permanent": false
    }
  ]
}
